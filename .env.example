# Database
POSTGRES_USER=kozove
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=kozove

# Application
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
APP_VERSION=0.2.0-alpha
PROXY_SHARED_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Administrator (Argon2id hash, not plaintext)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME

# Anti-abuse HMAC secret
ABUSE_PEPPER=CHANGE_TO_ANOTHER_LONG_RANDOM_SECRET

# Cloudflare Turnstile development TEST keys
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Public links
GITHUB_URL=https://github.com/xydojhuk/kozove
CONTACT_EMAIL=CHANGE_ME@example.com